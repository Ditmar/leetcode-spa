---
import BaseLayout from './BaseLayout.astro';
import NavShell from '../ui/components/common/NavShell';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Interactive coding practice platform' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <NavShell currentPath={currentPath} client:load />
  <slot />
</BaseLayout>