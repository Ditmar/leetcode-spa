---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppProvider from '../../context/AppConfigContext';
import ContestPage from '../../app/components/ContestPage/ContestPage';
import { contestsService } from '../../services/contests/contestsService';
import { getServerSession } from '../../services/auth/authService';
import { getConfig } from '../../utils/config';
import type { ContestDetail } from '../../services/contests/contestsService.types';

const config = getConfig();

if (!config.featureFlags.contests) {
  return Astro.redirect('/?comingSoon=contests', 302);
}

const cookie = Astro.request.headers.get('cookie') ?? '';
const options = { cookie };

const session = cookie ? await getServerSession(cookie) : null;
const user = session?.user ?? null;

let active: ContestDetail[] = [];
let upcoming: ContestDetail[] = [];
let past: ContestDetail[] = [];

try {
  const [activeRes, upcomingRes, pastRes] = await Promise.all([
    contestsService.getContests({ status: 'active' }, options),
    contestsService.getContests({ status: 'upcoming' }, options),
    contestsService.getContests({ status: 'past', pageSize: 10 }, options),
  ]);
  active = activeRes.contests as ContestDetail[];
  upcoming = upcomingRes.contests as ContestDetail[];
  past = pastRes.contests as ContestDetail[];
} catch {
  console.warn('[ContestsPage] Failed to load contests, rendering with empty lists');
}
---

<BaseLayout title="Contests — LeetCode Clone">
  <AppProvider client:load user={user}>
    <ContestPage
      activeContests={active}
      upcomingContests={upcoming}
      pastContests={past}
      client:load
    />
  </AppProvider>
</BaseLayout>